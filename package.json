{
  "name": "nour-eldeen-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:e2e": "next build && next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/accessibility",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "lighthouse": "lhci autorun",
    "media:scan": "node scripts/media/scan-projects.mjs",
    "media:inspect": "node scripts/media/inspect-video.mjs",
    "media:prepare": "node scripts/media/prepare-media.mjs",
    "media:poster": "node scripts/media/poster-media.mjs",
    "media:frames": "node scripts/media/frames-media.mjs",
    "media:validate": "node scripts/media/validate-media.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@react-three/fiber": "^9.6.1",
    "gsap": "3.15.0",
    "next": "16.2.11",
    "next-intl": "4.13.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
